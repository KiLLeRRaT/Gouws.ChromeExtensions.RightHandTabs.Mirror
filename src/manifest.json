{
  "manifest_version": 3,
  "name": "Right Hand Tabs",
  "version": "0.1.1",
  "description": "Vertical tab management panel on the right side of Chrome.",
  "permissions": ["tabs", "tabGroups", "sidePanel"],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Toggle the Right Hand Tabs panel"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Right Hand Tabs"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}
